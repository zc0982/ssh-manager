{
	"compilerOptions": {
		"composite": true,
		"target": "es2022",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"emitDeclarationOnly": true,
		"outDir": ".cloudflare/tsbuild/client",
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"paths": { "@/*": ["./client/*"] }
	},
	"include": ["client", "shared"]
}
