{
	"compilerOptions": {
		"composite": true,
		"target": "es2024",
		"lib": ["es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [],
		"strict": true,
		"emitDeclarationOnly": true,
		"outDir": ".cloudflare/tsbuild/worker",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src", "shared", "cloudflare.config.ts", ".cloudflare/types"]
}
