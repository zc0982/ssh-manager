# Worker 地址
SSH_MANAGER_URL=https://ssh-manager.<your-subdomain>.workers.dev
# Cloudflare Access service token（agent 用它通过 Access）
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# 可选
# AGENT_NAME=my-macbook
# SSH_SKILL_DIR=~/.claude/skills/ssh-skill
# 私钥文件：服务器密码用对应公钥加密，只有持有该私钥的 agent 能解密。多台电脑共用同一份私钥。
# SSH_MANAGER_KEY_FILE=~/.config/ssh-manager/agent_key.pem
